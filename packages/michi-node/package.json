{
  "name": "@orin-dx/michi",
  "version": "0.7.1",
  "description": "AXI response primitives for agent-ergonomic tools",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "FSL-1.1-MIT",
  "homepage": "https://orin-dx.com/tools/michi/",
  "bugs": {
    "url": "https://github.com/orin-dx/michi/issues"
  },
  "keywords": [
    "axi",
    "agent",
    "llm",
    "mcp",
    "toon",
    "cli",
    "napi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orin-dx/michi.git",
    "directory": "packages/michi-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "michi",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --js index.js --dts index.d.ts",
    "test": "node --test __test__/index.test.mjs __test__/interop.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "check": "pnpm typecheck && pnpm lint"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@toon-format/toon": "4.4.0",
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "optionalDependencies": {
    "@orin-dx/michi-darwin-arm64": "0.7.1",
    "@orin-dx/michi-darwin-x64": "0.7.1",
    "@orin-dx/michi-linux-arm64-gnu": "0.7.1",
    "@orin-dx/michi-linux-arm64-musl": "0.7.1",
    "@orin-dx/michi-linux-x64-gnu": "0.7.1",
    "@orin-dx/michi-linux-x64-musl": "0.7.1"
  }
}
